{
  "name": "macrotrace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-data.mjs && vite",
    "build": "node scripts/build-data.mjs && vite build",
    "data:pack": "node scripts/build-data.mjs",
    "delivery:verify": "node scripts/build-data.mjs && node scripts/verify-delivery.mjs",
    "preview": "vite preview",
    "data:refresh": "node scripts/refresh-data.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "panel:verify": "node scripts/verify-panel.mjs",
    "report:verify": "node scripts/verify-macro-report.mjs && node scripts/verify-parity.mjs",
    "site:verify": "node scripts/verify-site.mjs",
    "format": "prettier --write src scripts '*.html' '*.md' '*.json' vite.config.js '.github/workflows/*.yml'",
    "check": "npm run data:verify && npm run delivery:verify && npm run panel:verify && npm run report:verify && npm run site:verify && npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.8",
    "vite": "^6.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
